# SITE_ADDRESS comes from deploy/oracle/.env:
#   ":80"            -> plain HTTP on the server's IP (before there is a domain)
#   "mundoflag.com"  -> Caddy gets and renews a free HTTPS certificate by itself
{$SITE_ADDRESS} {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		# browsers that saw the site once refuse plain http to it for a year
		# (only honored over HTTPS, so harmless while SITE_ADDRESS is still :80)
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy app:8080
}
